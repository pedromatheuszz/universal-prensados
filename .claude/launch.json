{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--config",
        "site/vite.config.js",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--config",
        "site/vite.config.js",
        "--port",
        "3000",
        "--strictPort"
      ],
      "port": 3000,
      "env": {
        "NO_OPEN": "1"
      }
    },
    {
      "name": "dev-banco-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--config",
        "site/vite.config.js",
        "--port",
        "3001",
        "--strictPort"
      ],
      "port": 3001,
      "env": {
        "NO_OPEN": "1",
        "DATABASE_URL": ""
      }
    }
  ]
}
