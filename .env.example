# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# String de conexão do Neon (Dashboard → Connection Details → "Pooled connection").
# Sem ela, o `npm run dev` usa um Postgres local em .data/dev-db.
DATABASE_URL=

# Segredo que assina as sessões do painel (32+ caracteres aleatórios).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Usuário de teste criado automaticamente no banco LOCAL de desenvolvimento.
DEV_STAFF_USER=equipe
DEV_STAFF_PASSWORD=equipe-dev-123
