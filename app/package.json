{
  "name": "universal-gestao",
  "productName": "Universal Gestão",
  "version": "1.0.0",
  "description": "App de gestão da Universal Prensados: pedidos do site, cardápio, loja, caixa, financeiro e equipe",
  "author": "Universal Prensados",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "br.com.universalprensados.gestao",
    "productName": "Universal Gestão",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "lib/**",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Universal Gestão"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "toolsets": {
      "winCodeSign": "1.1.0"
    }
  },
  "allowScripts": {
    "electron@45.2.3": true,
    "electron-winstaller@5.4.0": true
  }
}
