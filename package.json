{
  "name": "universal-prensados",
  "version": "1.0.0",
  "description": "Universal Prensados — site de pedidos (site/), API (server/, netlify/) e app de gestão para Windows (app/)",
  "type": "module",
  "scripts": {
    "catalog": "node site/scripts/build-catalog.js",
    "predev": "npm run catalog",
    "dev": "vite --config site/vite.config.js",
    "prebuild": "npm run catalog",
    "build": "vite build --config site/vite.config.js",
    "preview": "vite preview --config site/vite.config.js",
    "product-art": "node site/scripts/build-product-art.js",
    "optimize-images": "node site/scripts/optimize-images.js",
    "generate-pwa-icons": "node site/scripts/generate-pwa-icons.js",
    "lint": "eslint . --ext .js,.cjs",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/db-migrate.js",
    "staff:add": "node scripts/staff-add.js",
    "app": "npm --prefix app start",
    "app:install": "npm --prefix app install",
    "app:dist": "npm --prefix app run dist"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.40.0",
    "eslint": "^8.56.0",
    "jsdom": "^23.0.0",
    "sharp": "^0.33.2",
    "terser": "^5.24.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "gsap": "3.15.0"
  }
}
